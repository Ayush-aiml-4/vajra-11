<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- Explicitly NOT declared: RECORD_AUDIO, READ_SMS, ACCESS_FINE_LOCATION (deferred) -->

    <queries>
        <intent>
            <action android:name="com.google.zxing.client.android.SCAN" />
        </intent>
    </queries>

    <application
        android:name=".VajraApp"
        android:allowBackup="false"
        android:icon="@drawable/ic_vajra"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.VajraCompanion"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.VajraCompanion">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".ui.EnrollmentActivity" android:exported="false" />
        <activity android:name=".ui.SettingsActivity" android:exported="false" />
        <activity android:name=".ui.PrivacyActivity" android:exported="false" />
    </application>
</manifest>
