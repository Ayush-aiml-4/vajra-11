<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#08090B"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Top Header & Brand -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/imgBrandLogo"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_vajra" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtAppTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textColor="#F4F1EA"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtAppTagline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_tagline"
                    android:textColor="#C8A66A"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/badgeStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#161B22"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="Not Enrolled"
                android:textColor="#9499A3"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- STATE A: ONBOARDING / NOT ENROLLED -->
        <LinearLayout
            android:id="@+id/layoutOnboarding"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="vertical"
            android:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#101216"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Zero-Trust Endpoint Protection"
                    android:textColor="#F4F1EA"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:lineSpacingExtra="3dp"
                    android:text="@string/onboarding_hero_desc"
                    android:textColor="#9499A3"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btnConnectDevice"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="20dp"
                    android:backgroundTint="#C8A66A"
                    android:text="@string/btn_connect_device"
                    android:textColor="#08090B"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Security Assurance Highlights -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="#101216"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Cryptographic Guarantees"
                    android:textColor="#C8A66A"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:lineSpacingExtra="2dp"
                    android:text="• Hardware Keystore: Private ECDSA P-256 keys remain inside Android Keystore.\n• Plane-2 Isolation: Telemetry signed with asymmetric proofs-of-possession.\n• Zero Covert Monitoring: No SMS, photos, microphone, or keylogging."
                    android:textColor="#9499A3"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- STATE B: ENROLLED COMPANION DASHBOARD -->
        <LinearLayout
            android:id="@+id/layoutDashboard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- Device Identity Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#101216"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="DEVICE IDENTITY"
                    android:textColor="#646A74"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtDeviceModel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Android Device"
                    android:textColor="#F4F1EA"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtKeystoreTrust"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Hardware Keystore (TEE)"
                    android:textColor="#75B798"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtFingerprint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="#08090B"
                    android:padding="8dp"
                    android:textColor="#C8A66A"
                    android:textIsSelectable="true"
                    android:textSize="11sp"
                    android:typeface="monospace" />
            </LinearLayout>

            <!-- Mesh Status & Capabilities -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="#101216"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="TELEMETRY &amp; CAPABILITIES"
                    android:textColor="#646A74"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtServerUrl"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="#9499A3"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/txtHeartbeatStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="#9499A3"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/txtAuthorizedCommands"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Authorized Commands: Device Status (REQUEST_DEVICE_STATUS), Ring Alarm (RING_DEVICE)"
                    android:textColor="#C8A66A"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/txtDeferredCommands"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Deferred / Not Supported on Companion: GPS Location, Remote Lock, Remote Wipe"
                    android:textColor="#646A74"
                    android:textSize="10sp" />
            </LinearLayout>

            <!-- Action Controls -->
            <Button
                android:id="@+id/btnRefreshStatus"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="16dp"
                android:backgroundTint="#161B22"
                android:text="Refresh Telemetry"
                android:textColor="#F4F1EA" />

            <Button
                android:id="@+id/btnDisconnect"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="10dp"
                android:backgroundTint="#211214"
                android:text="Disconnect / Unpair Device"
                android:textColor="#F85149" />
        </LinearLayout>

        <!-- Global Footer Links -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnPrivacyLink"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="8dp"
                android:text="Privacy Disclosure"
                android:textColor="#9499A3"
                android:textSize="12sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" · "
                android:textColor="#646A74" />

            <TextView
                android:id="@+id/btnSettingsLink"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="8dp"
                android:text="Settings"
                android:textColor="#9499A3"
                android:textSize="12sp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
